{
  "name": "@johnmorrisdotca/meikyuu",
  "version": "3.1.1",
  "description": "Meikyuu 迷宮, mazes for JavaScript and TypeScript: squares, hexagons, triangles, circles and cut-out shapes, even dice, a globe, a torus or a heart, made by seven algorithms from a seed and drawn through with a finger or the mouse. Zero dependencies.",
  "keywords": [
    "maze",
    "labyrinth",
    "maze-game",
    "maze-generator",
    "maze-solver",
    "puzzle",
    "puzzle-game",
    "arrows",
    "hexagon",
    "seeded-random",
    "levels",
    "typescript",
    "javascript",
    "zero-dependencies",
    "browser",
    "node",
    "itsutsu",
    "svg",
    "custom-element",
    "web-component",
    "colossal",
    "stones",
    "3d",
    "cube",
    "sphere",
    "icosahedron",
    "octahedron",
    "dice",
    "dodecahedron",
    "torus",
    "heart",
    "solid",
    "canvas"
  ],
  "homepage": "https://johnmorrisdotca.github.io/meikyuu/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/meikyuu.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/meikyuu/issues"
  },
  "author": "John Morris",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/element-define.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./draw": {
      "types": "./dist/draw-entry.d.ts",
      "import": "./dist/draw-entry.js",
      "default": "./dist/draw-entry.js"
    },
    "./play": {
      "types": "./dist/play-entry.d.ts",
      "import": "./dist/play-entry.js",
      "default": "./dist/play-entry.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./element/define": {
      "types": "./dist/element-define.d.ts",
      "import": "./dist/element-define.js",
      "default": "./dist/element-define.js"
    },
    "./levels": {
      "types": "./dist/levels.d.ts",
      "import": "./dist/levels.js",
      "default": "./dist/levels.js"
    },
    "./levels/tall": {
      "types": "./dist/levels-tall.d.ts",
      "import": "./dist/levels-tall.js",
      "default": "./dist/levels-tall.js"
    },
    "./levels/colossal": {
      "types": "./dist/levels-colossal.d.ts",
      "import": "./dist/levels-colossal.js",
      "default": "./dist/levels-colossal.js"
    },
    "./levels/legacy": {
      "types": "./dist/levels-legacy.d.ts",
      "import": "./dist/levels-legacy.js",
      "default": "./dist/levels-legacy.js"
    },
    "./3d": {
      "types": "./dist/solid-entry.d.ts",
      "import": "./dist/solid-entry.js",
      "default": "./dist/solid-entry.js"
    },
    "./3d/play": {
      "types": "./dist/solid-play-entry.d.ts",
      "import": "./dist/solid-play-entry.js",
      "default": "./dist/solid-play-entry.js"
    },
    "./3d/levels": {
      "types": "./dist/levels-solid.d.ts",
      "import": "./dist/levels-solid.js",
      "default": "./dist/levels-solid.js"
    },
    "./3d/levels/dice": {
      "types": "./dist/levels-solid-dice.d.ts",
      "import": "./dist/levels-solid-dice.js",
      "default": "./dist/levels-solid-dice.js"
    },
    "./3d/levels/shapes": {
      "types": "./dist/levels-solid-shapes.d.ts",
      "import": "./dist/levels-solid-shapes.js",
      "default": "./dist/levels-solid-shapes.js"
    },
    "./3d/levels/recipes": {
      "types": "./dist/levels-solid-recipes.d.ts",
      "import": "./dist/levels-solid-recipes.js",
      "default": "./dist/levels-solid-recipes.js"
    },
    "./3d/levels/all": {
      "types": "./dist/levels-solid-all.d.ts",
      "import": "./dist/levels-solid-all.js",
      "default": "./dist/levels-solid-all.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "family:readme": "node scripts/family-readme.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build",
    "site": "pnpm build && node scripts/site.mjs",
    "test:demo": "pnpm site && playwright test",
    "docs:make": "node scripts/docs.mjs",
    "levels": "node --experimental-strip-types scripts/meikyuu-levels.ts",
    "levels:rescore": "node --experimental-strip-types scripts/meikyuu-rescore.ts",
    "pictures:levels": "pnpm site && node scripts/levels-pictures.mjs",
    "screenshots:readme": "pnpm site && node scripts/readme-pictures.mjs",
    "test:readme": "pnpm build && node scripts/check-readme-examples.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.11.0"
}
